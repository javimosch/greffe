// greffe — the node: a single event loop owns all state (race-free by construction).
// Goroutines only accept sockets, read requests, dial peers, hold subscriptions and
// tick; every result comes back to the loop as a string event over one channel:
//   "tick" | "in\t<fd>\t<raw request>" | "re\t<peer>\t<raw reply>" | "push\t<peer>\t<line>" | "subend\t<peer>\t"
//
// Wire protocol, one TCP port for everything (default 7420):
//   a request starting with "{" is a peer message: one JSON line in, one JSON line out
//   ("sub" keeps the socket open and streams announcements); anything else is HTTP.
// Peers are dialled directly (LAN / Tailscale / public IP). A node behind NAT sets
// nat=true: it advertises no port, subscribes to its peers (relays) for pushes, and
// pulls/pushes over its own outbound dials. Any public full node is a relay; it holds
// no key power, so several relays need no coordination — fork choice reconciles them.

var g_evch = make(chan string)

// Scalars that must outlive an arena_reset(): ints survive, computed strings do not.
var g_ctr = make(map[string]int)

// Relay side: fds of subscribed NAT'd peers (fd -> 1). Subscriber side: per-peer subscription
// state keyed by an int hash of the address (1 = live) and the last attempt time.
var g_subfds = make(map[int]int)
var g_sub = make(map[int]int)
var g_sub_ts = make(map[int]int)

// Long-lived string-keyed maps, made ONCE: a map made in the main goroutine is malloc-backed
// and outlives arena_reset(), so re-making them on every reload would leak the old ones.
var g_included = make(map[string]bool)
var g_byhash = make(map[string]int)
var g_pend_ids = make(map[string]bool)
var g_pend_since = make(map[string]int)
var g_inflight = make(map[string]bool)
var g_sync_from = make(map[string]int)
var g_sync_anc = make(map[string]int)
var g_side = make(map[string]string)
var g_side_prev = make(map[string]string)

func maps_reset() {
    map_clear_sb(g_included)
    map_clear_si(g_byhash)
    map_clear_sb(g_pend_ids)
    map_clear_si(g_pend_since)
    map_clear_sb(g_inflight)
    map_clear_si(g_sync_from)
    map_clear_si(g_sync_anc)
    map_clear_ss(g_side)
    map_clear_ss(g_side_prev)
}

type Msg struct { t string  genesis string  height int  tip string  weight int  port int  nat int  from int  npending int  raws []string  raw string  entries []Entry  entry Entry  err string }

type Peer struct { addr string  height int  weight int  seen int  fails int  source string }

type Node struct { cfg Config  datadir string  seedhex string  pub string  chain Chain  pending []Entry  pend_since map[string]int  pend_ids map[string]bool  peers []Peer  inflight map[string]bool  sync_from map[string]int  sync_anc map[string]int  side map[string]string  side_prev map[string]string  side_n int  last_sync int  started int  sealed int  reorgs int }

func logmsg(s) {
    println(time_format_utc(now(), "%Y-%m-%dT%H:%M:%SZ") + " " + s)
    flush()
}

// ---- goroutines (no shared state; everything travels over ch as strings) ----

func gr_ticker(ch) { for { sleep(1000)  ch <- "tick" } }

func gr_acceptor(srv, ch) {
    for {
        fd := accept(srv)
        if fd >= 0 {
            socket_timeout(fd, 4000)
            go gr_reader(fd, ch)
        }
    }
}

func read_line_fd(fd) (raw) {
    raw = ""
    while index(raw, "\n") < 0 {
        more := read(fd)
        if len(more) == 0 { return }
        raw = raw + more
        if len(raw) > 8000000 { return }
    }
}

// read_req reads a whole peer line or a whole HTTP request (headers + Content-Length body).
func read_req(fd) (raw) {
    raw = read(fd)
    if len(raw) == 0 { return }
    if has_prefix(raw, "{") {
        while index(raw, "\n") < 0 {
            more := read(fd)
            if len(more) == 0 { return }
            raw = raw + more
            if len(raw) > 8000000 { return }
        }
        return
    }
    while index(raw, "\r\n\r\n") < 0 {
        more2 := read(fd)
        if len(more2) == 0 { return }
        raw = raw + more2
        if len(raw) > 65536 { return }
    }
    hend := index(raw, "\r\n\r\n") + 4
    clen := content_length(substr(raw, 0, hend))
    if clen > 1000000 { raw = ""  return }
    while len(raw) - hend < clen {
        more3 := read(fd)
        if len(more3) == 0 { return }
        raw = raw + more3
    }
}

func gr_reader(fd, ch) {
    raw := read_req(fd)
    ch <- "in\t" + str(fd) + "\t" + raw
}

func split_addr(addr) (host, port) {
    host = addr
    port = 7420
    c := index(addr, ":")
    if c >= 0 {
        host = substr(addr, 0, c)
        port = parse_int(substr(addr, c + 1, len(addr)))
    }
}

// gr_fetch: request/reply to a peer; the reply (or "" on failure) comes back as an event.
func gr_fetch(addr, line, ch) {
    reply := ""
    host, port := split_addr(addr)
    fd := dial(host, port)
    if fd >= 0 {
        socket_timeout(fd, 4000)
        write(fd, line + "\n")
        reply = read_line_fd(fd)
        close(fd)
    }
    ch <- "re\t" + addr + "\t" + reply
}

// gr_announce: fire-and-forget push (a new entry or block); no event comes back.
func gr_announce(addr, line) {
    host, port := split_addr(addr)
    fd := dial(host, port)
    if fd >= 0 {
        socket_timeout(fd, 4000)
        write(fd, line + "\n")
        read_line_fd(fd)
        close(fd)
    }
}

// gr_announce_seq: several announce lines (joined by "\n"), one dial each, IN ORDER — how a
// node pushes a run of blocks to a peer that is behind and may be unable to dial it back.
func gr_announce_seq(addr, joined) {
    lines := split(joined, "\n")
    i := 0
    while i < len(lines) {
        if len(lines[i]) > 0 { gr_announce(addr, lines[i]) }
        i = i + 1
    }
}

// gr_subscribe: a NAT'd node's long-lived outbound link to a relay. Sends "sub", then turns
// every pushed line into a "push" event; "subend" when the link drops.
func gr_subscribe(addr, line, ch) {
    host, port := split_addr(addr)
    fd := dial(host, port)
    if fd >= 0 {
        socket_timeout(fd, 90000)   // relays ping every 30s; 3 missed pings = dead link
        write(fd, line + "\n")
        buf := ""
        alive := true
        while alive {
            more := read(fd)
            if len(more) == 0 { alive = false } else {
                buf = buf + more
                nl := index(buf, "\n")
                while nl >= 0 {
                    ch <- "push\t" + addr + "\t" + substr(buf, 0, nl)
                    buf = substr(buf, nl + 1, len(buf))
                    nl = index(buf, "\n")
                }
                if len(buf) > 8000000 { alive = false }
            }
        }
        close(fd)
    }
    ch <- "subend\t" + addr + "\t"
}

func addr_hash(addr) (h) {
    h = 7
    b := bytes(addr)
    i := 0
    while i < len(b) { h = (h * 31 + byte_at(b, i)) % 1000000007  i = i + 1 }
}

// ---- messages ----

func msg_base(n, t) (m) {
    m = Msg{t: t, genesis: n.chain.heads[0].hash, height: 0, tip: "", weight: 0, port: adv_port(n), nat: 0, from: 0, npending: 0, raws: []string{}, raw: "", entries: []Entry{}, entry: Entry{}, err: ""}
}

// adv_port: the port we tell peers to dial back; 0 when behind NAT (nobody can).
func adv_port(n) (p) {
    p = n.cfg.port
    if n.cfg.nat { p = 0 }
}

func hello_line(n) (s) {
    tip := chain_tip(n.chain)
    m := msg_base(n, "hello")
    m.height = tip.height
    m.tip = tip.hash
    m.weight = n.chain.weight
    if n.cfg.nat { m.nat = 1 }
    m.npending = len(n.pending)
    s = json(m)
}

func msg_ok(err) (s) { s = json(Msg{t: "ok", genesis: "", height: 0, tip: "", weight: 0, port: 0, nat: 0, from: 0, npending: 0, raws: []string{}, raw: "", entries: []Entry{}, entry: Entry{}, err: err}) }

func block_line(n, raw) (s) {
    m := msg_base(n, "block")
    m.raw = raw
    s = json(m)
}

func entry_line(n, e) (s) {
    m := msg_base(n, "entry")
    m.entry = e
    s = json(m)
}

// raws_from pages by block count AND by total entries, so one reply stays small.
func raws_from(n, from, limit) (rs) {
    rs = []string{}
    i := from
    if i < 0 { i = 0 }
    total := 0
    while i < len(n.chain.raws) && len(rs) < limit && total < 400 {
        rs = append(rs, n.chain.raws[i])
        total = total + n.chain.heads[i].n
        i = i + 1
    }
}

// ---- node state ----

func node_load(dir) (n, err) {
    err = ""
    cfg, ok := store_load_config(dir)
    if ok == false { err = "no valid config in " + dir + " (run: greffe init)"  return }
    seedhex := store_load_seed(dir)
    if len(seedhex) != 64 { err = "missing or bad node.key in " + dir  return }
    pub := to_hex(ed25519_pub(from_hex(seedhex)))
    raws := store_load_raws(dir)
    maps_reset()
    chain, applied, cerr := chain_rebuild_into(cfg, raws, g_included, g_byhash)
    if len(cerr) > 0 { err = "chain.jsonl: " + cerr  return }
    if len(raws) == 0 { store_rewrite_raws(dir, chain.raws) }
    n = Node{cfg: cfg, datadir: dir, seedhex: seedhex, pub: pub, chain: chain, pending: []Entry{}, pend_since: g_pend_since, pend_ids: g_pend_ids, peers: []Peer{}, inflight: g_inflight, sync_from: g_sync_from, sync_anc: g_sync_anc, side: g_side, side_prev: g_side_prev, side_n: 0, last_sync: 0, started: now(), sealed: 0, reorgs: 0}
    i := 0
    while i < len(cfg.peers) { n = peer_learn(n, cfg.peers[i], "config")  i = i + 1 }
    learned := store_load_peers(dir)
    k := 0
    while k < len(learned) { n = peer_learn(n, learned[k], "learned")  k = k + 1 }
    saved := store_load_pending(dir)
    j := 0
    while j < len(saved) { if has(chain.included, saved[j].id) == false { n = pending_add(n, saved[j]) }  j = j + 1 }
    if g_ctr["gcs"] == 0 { logmsg("loaded " + str(applied) + " blocks, weight " + str(chain.weight) + ", " + str(len(n.pending)) + " pending, " + str(len(n.peers)) + " peers") }
}

func node_is_validator(n) (ok) { ok = is_in(n.chain.validators, n.pub) }

func peer_index(n, addr) (idx) {
    idx = -1
    i := 0
    while i < len(n.peers) { if n.peers[i].addr == addr { idx = i }  i = i + 1 }
}

func peer_learn(n, addr, source) (out) {
    out = n
    if len(addr) == 0 { return }
    if peer_index(out, addr) >= 0 { return }
    if len(out.peers) >= 64 { return }
    out.peers = append(out.peers, Peer{addr: addr, height: -1, weight: -1, seen: 0, fails: 0, source: source})
    if source == "hello" {
        // remember peers that found us, so a restart still knows the federation
        learned := []string{}
        i := 0
        while i < len(out.peers) { if out.peers[i].source != "config" { learned = append(learned, out.peers[i].addr) }  i = i + 1 }
        store_save_peers(out.datadir, learned)
    }
}

func peer_mark(n, addr, height, weight, ok) (out) {
    out = n
    idx := peer_index(out, addr)
    if idx < 0 { return }
    if ok {
        out.peers[idx].height = height
        out.peers[idx].weight = weight
        out.peers[idx].seen = now()
        out.peers[idx].fails = 0
    } else {
        out.peers[idx].fails = out.peers[idx].fails + 1
    }
}

// pending_accept: validate + queue an entry. Returns (node, accepted, reason).
func pending_accept(n, e) (out, ok, reason) {
    out = n
    ok = false
    reason = ""
    if entry_valid(e) == false { reason = "invalid entry (id or signature)"  return }
    if has(out.chain.included, e.id) { reason = "already in chain"  return }
    if has(out.pend_ids, e.id) { reason = "already pending"  return }
    if entry_allowed(out.chain, e) == false { reason = "author is not a validator or member"  return }
    if len(out.pending) >= 10000 { reason = "pending queue full"  return }
    out = pending_add(out, e)
    ok = true
}

func pending_add(n, e) (out) {
    out = n
    if has(out.pend_ids, e.id) { return }
    out.pending = append(out.pending, e)
    out.pend_ids[e.id] = true
    out.pend_since[e.id] = now()
}

// pending_prune drops entries now included in the chain.
func pending_prune(n) (out) {
    out = n
    keep := []Entry{}
    i := 0
    while i < len(out.pending) {
        e := out.pending[i]
        if has(out.chain.included, e.id) {
            delete(out.pend_ids, e.id)
            delete(out.pend_since, e.id)
        } else {
            keep = append(keep, e)
        }
        i = i + 1
    }
    out.pending = keep
}

// ---- outbound ----

func node_send(n, addr, line) (out) {
    out = n
    if len(addr) == 0 { return }
    if has(out.inflight, addr) && out.inflight[addr] { return }
    out.inflight[addr] = true
    go gr_fetch(addr, line, g_evch)
}

func node_broadcast(n, line) {
    sub_push_all(line)
    i := 0
    while i < len(n.peers) {
        p := n.peers[i]
        if p.fails < 20 || p.source == "config" { go gr_announce(p.addr, line) }
        i = i + 1
    }
}

// want_sync: ask addr for blocks starting at a height (it includes that block so we can
// confirm a common ancestor).
func want_sync(n, addr, from) (out) {
    out = n
    if len(addr) == 0 { return }
    if from < 0 { from = 0 }
    out.sync_from[addr] = from
    m := msg_base(out, "blocks")
    m.from = from
    out = node_send(out, addr, json(m))
}

// push_from: announce our blocks after height h to addr, in order (bounded per round).
func push_from(n, addr, h) {
    lines := []string{}
    i := h + 1
    while i < len(n.chain.raws) && len(lines) < 25 { lines = append(lines, block_line(n, n.chain.raws[i]))  i = i + 1 }
    if len(lines) > 0 { go gr_announce_seq(addr, join(lines, "\n")) }
}

// ---- applying blocks ----

func node_append(n, raw, source) (out, err) {
    out = n
    c, e := chain_ingest(out.chain, raw)
    err = e
    if len(err) > 0 { return }
    out.chain = c
    store_append_raw(out.datadir, raw)
    out = pending_prune(out)
    store_save_pending(out.datadir, out.pending)
    h := chain_tip(out.chain)
    logmsg("block " + str(h.height) + " " + substr(h.hash, 0, 12) + " (" + str(h.n) + " entries, weight " + str(out.chain.weight) + ") from " + source)
}

// orphan_lines: JSON lines of the entries in raw that the (new) chain does not include.
func orphan_lines(raw, c) (lines) {
    lines = ""
    arena {
        b := parse(raw, Block{})
        xs := []string{}
        i := 0
        while i < len(b.entries) {
            if has(c.included, b.entries[i].id) == false { xs = append(xs, json(b.entries[i])) }
            i = i + 1
        }
        lines = escape(join(xs, "\n"))
    }
}

// try_candidate: our chain up to anc + extra raw lines. Judged inside an arena (nothing parsed
// survives); adopted only if fork choice prefers it, by rebuilding into the live maps.
func try_candidate(n, anc, extra, source) (out, changed) {
    out = n
    changed = false
    cand := []string{}
    k := 0
    while k <= anc && k < len(out.chain.raws) { cand = append(cand, out.chain.raws[k])  k = k + 1 }
    m := 0
    while m < len(extra) { cand = append(cand, extra[m])  m = m + 1 }
    err, cw, ctip := chain_judge(out.cfg, cand)
    if len(err) > 0 { logmsg("reject fork from " + source + ": " + err)  return }
    if chain_better(cw, ctip, out.chain) == false { return }
    oldh := chain_tip(out.chain).height
    oldw := out.chain.weight
    oldtail := []string{}
    t := anc + 1
    while t < len(out.chain.raws) { oldtail = append(oldtail, out.chain.raws[t])  t = t + 1 }
    map_clear_sb(g_included)
    map_clear_si(g_byhash)
    c, applied, err2 := chain_rebuild_into(out.cfg, cand, g_included, g_byhash)
    if len(err2) > 0 { logmsg("BUG: candidate failed on second rebuild: " + err2)  exit(4) }
    out.chain = c
    out.reorgs = out.reorgs + 1
    store_rewrite_raws(out.datadir, c.raws)
    // entries orphaned by the reorg go back to pending
    i := 0
    while i < len(oldtail) {
        ol := orphan_lines(oldtail[i], out.chain)
        if len(ol) > 0 {
            ls := split(ol, "\n")
            j := 0
            while j < len(ls) { out = pending_add(out, parse(ls[j], Entry{}))  j = j + 1 }
        }
        i = i + 1
    }
    out = pending_prune(out)
    store_save_pending(out.datadir, out.pending)
    changed = true
    logmsg("adopted chain height " + str(chain_tip(c).height) + " weight " + str(c.weight) + " (was " + str(oldh) + "/" + str(oldw) + ") from " + source)
}

// side_add: buffer a block we cannot append yet; returns false if already known.
func side_add(n, raw, bhash, bprev) (out) {
    out = n
    if has(out.side, bhash) { return }
    if out.side_n >= 400 {
        map_clear_ss(out.side)
        map_clear_ss(out.side_prev)
        out.side_n = 0
    }
    out.side[bhash] = raw
    out.side_prev[bhash] = bprev
    out.side_n = out.side_n + 1
}

// side_assemble: from a buffered block, follow prev pointers down to a block we hold and try
// the assembled branch as a candidate. Returns (node, adopted, complete).
func side_assemble(n, bhash, source) (out, changed, complete) {
    out = n
    changed = false
    complete = false
    path := []string{bhash}
    cur := out.side_prev[bhash]
    depth := 0
    while has(out.chain.byhash, cur) == false && depth < 400 {
        if has(out.side, cur) == false { cur = ""  depth = 400 } else { path = append(path, cur)  cur = out.side_prev[cur]  depth = depth + 1 }
    }
    if len(cur) == 0 || has(out.chain.byhash, cur) == false { return }
    complete = true
    anc := out.chain.byhash[cur]
    extra := []string{}
    i := len(path) - 1
    while i >= 0 { extra = append(extra, out.side[path[i]])  i = i - 1 }
    o, ch := try_candidate(out, anc, extra, source)
    out = o
    changed = ch
}

// on_blocks: a page of raw blocks from addr. Two phases per peer: locate the common ancestor
// (walk back while the first block mismatches), then page the peer's branch into the side
// buffer and assemble it; if the branch loses fork choice, push ours from the ancestor.
func on_blocks(n, addr, rs) (out) {
    out = n
    asked := out.sync_from[addr]
    delete(out.sync_from, addr)
    if len(rs) == 0 { delete(out.sync_anc, addr)  return }
    fh, fp, fhash := raw_head(rs[0])
    if fh != asked { delete(out.sync_anc, addr)  return }
    if has(out.sync_anc, addr) == false {
        if fh >= len(out.chain.heads) { return }
        if out.chain.heads[fh].hash != fhash {
            if fh > 0 { out = want_sync(out, addr, fh - 1) }
            return
        }
        out.sync_anc[addr] = fh
    }
    anc := out.sync_anc[addr]
    tip := chain_tip(out.chain)
    if len(rs) == 1 && fh == anc {
        // the peer's chain ends at our block: it is behind us -> push what it lacks
        delete(out.sync_anc, addr)
        if anc < tip.height { push_from(out, addr, anc) }
        return
    }
    lasthash := ""
    lasth := fh
    i := 0
    if fh == anc { i = 1 }
    while i < len(rs) {
        bh, bprev, bhash := raw_head(rs[i])
        if has(out.chain.byhash, bhash) == false {
            if bh == chain_tip(out.chain).height + 1 && bprev == chain_tip(out.chain).hash {
                o, err := node_append(out, rs[i], addr)
                if len(err) > 0 { logmsg("reject block from " + addr + ": " + err)  delete(out.sync_anc, addr)  return }
                out = o
            } else {
                out = side_add(out, rs[i], bhash, bprev)
                lasthash = bhash
            }
        }
        lasth = bh
        i = i + 1
    }
    if len(rs) >= 2 && lasth - anc < 2000 {
        // more may follow: continue from the last block of this page
        out = want_sync(out, addr, lasth)
        return
    }
    delete(out.sync_anc, addr)
    if len(lasthash) > 0 {
        o2, changed, complete := side_assemble(out, lasthash, addr)
        out = o2
        if changed { node_broadcast(out, block_line(out, out.side[lasthash])) }
        if changed == false && complete { push_from(out, addr, anc) }
    }
}

func on_hello(n, addr, m) (out) {
    out = n
    if m.genesis != out.chain.heads[0].hash { out = peer_mark(out, addr, m.height, m.weight, false)  return }
    out = peer_mark(out, addr, m.height, m.weight, true)
    if len(addr) == 0 { return }
    if m.npending > 0 && node_is_validator(out) && has(out.sync_from, addr) == false {
        out = node_send(out, addr, json(msg_base(out, "pending")))
    }
    tip := chain_tip(out.chain)
    differs := m.weight != out.chain.weight || m.tip != tip.hash
    if differs && has(out.sync_from, addr) == false {
        // ahead, behind or forked: find the common ancestor, then pull (if better) or push
        delete(out.sync_anc, addr)
        from := m.height
        if tip.height < from { from = tip.height }
        out = want_sync(out, addr, from)
    }
}

// on_block_announce: extend the tip, or buffer a side block and try to assemble a fork.
func on_block_announce(n, addr, raw) (out) {
    out = n
    bh, bprev, bhash := raw_head(raw)
    if bh < 0 || len(bhash) == 0 { return }
    if has(out.chain.byhash, bhash) { return }
    tip := chain_tip(out.chain)
    if bh == tip.height + 1 && bprev == tip.hash {
        o, err := node_append(out, raw, addr)
        if len(err) > 0 { logmsg("reject announced block " + str(bh) + ": " + err)  return }
        out = o
        node_broadcast(out, block_line(out, raw))
        return
    }
    if has(out.side, bhash) { return }
    out = side_add(out, raw, bhash, bprev)
    o2, changed, complete := side_assemble(out, bhash, addr)
    out = o2
    if changed { node_broadcast(out, block_line(out, raw))  return }
    if complete == false && len(addr) > 0 { out = want_sync(out, addr, tip.height) }
}

// ---- inbound peer messages ----

func handle_p2p(n, raw, remote_ip) (out, resp) {
    out = n
    m := parse(raw, Msg{})
    addr := ""
    if m.port > 0 && len(remote_ip) > 0 && m.nat == 0 {
        addr = remote_ip + ":" + str(m.port)
        out = peer_learn(out, addr, "hello")
    }
    if m.t == "hello" {
        out = on_hello(out, addr, m)
        resp = hello_line(out)
        return
    }
    if m.genesis != out.chain.heads[0].hash { resp = msg_ok("genesis mismatch")  return }
    if m.t == "blocks" {
        r := msg_base(out, "blocks")
        r.from = m.from
        r.raws = raws_from(out, m.from, 100)
        resp = json(r)
        return
    }
    if m.t == "pending" {
        r2 := msg_base(out, "pending")
        pl := []Entry{}
        i := 0
        while i < len(out.pending) && len(pl) < 200 { pl = append(pl, out.pending[i])  i = i + 1 }
        r2.entries = pl
        r2.npending = len(out.pending)
        resp = json(r2)
        return
    }
    if m.t == "entry" {
        o, ok, reason := pending_accept(out, m.entry)
        out = o
        if ok {
            store_append_pending(out.datadir, m.entry)
            node_broadcast(out, entry_line(out, m.entry))
            resp = msg_ok("")
        } else {
            resp = msg_ok(reason)
        }
        return
    }
    if m.t == "block" {
        out = on_block_announce(out, addr, m.raw)
        resp = msg_ok("")
        return
    }
    resp = msg_ok("unknown message type")
}

// on_push: a line pushed by a relay over our subscription.
func on_push(n, addr, raw) (out) {
    out = n
    if has_prefix(raw, "{") == false { return }
    m := parse(raw, Msg{})
    if m.t == "ping" { return }
    if m.t == "hello" { out = on_hello(out, addr, m)  return }
    if m.genesis != out.chain.heads[0].hash { return }
    if m.t == "block" { out = on_block_announce(out, addr, m.raw)  return }
    if m.t == "entry" {
        o, ok, reason := pending_accept(out, m.entry)
        out = o
        if ok {
            store_append_pending(out.datadir, m.entry)
            node_broadcast(out, entry_line(out, m.entry))
        }
    }
}

func sub_push_all(line) {
    fds := keys(g_subfds)
    i := 0
    while i < len(fds) {
        fd := fds[i]
        if write(fd, line + "\n") < 0 { close(fd)  delete(g_subfds, fd) }
        i = i + 1
    }
}

func sub_maintain(n) (out) {
    out = n
    if out.cfg.nat == false { return }
    t := now()
    i := 0
    while i < len(out.peers) {
        p := out.peers[i]
        h := addr_hash(p.addr)
        if g_sub[h] != 1 && t - g_sub_ts[h] >= 15 {
            g_sub[h] = 1
            g_sub_ts[h] = t
            sm := msg_base(out, "sub")
            sm.nat = 1
            go gr_subscribe(p.addr, json(sm), g_evch)
        }
        i = i + 1
    }
}

func on_reply(n, addr, raw) (out) {
    out = n
    out.inflight[addr] = false
    if len(raw) == 0 {
        out = peer_mark(out, addr, 0, 0, false)
        delete(out.sync_from, addr)
        delete(out.sync_anc, addr)
        return
    }
    m := parse(raw, Msg{})
    if m.t == "hello" { out = on_hello(out, addr, m)  return }
    if m.t == "blocks" { out = on_blocks(out, addr, m.raws)  return }
    if m.t == "pending" {
        i := 0
        while i < len(m.entries) {
            o, ok, reason := pending_accept(out, m.entries[i])
            out = o
            if ok { store_append_pending(out.datadir, m.entries[i]) }
            i = i + 1
        }
    }
}

// ---- sealing (proof of authority, Clique-style) ----

func try_seal(n) (out) {
    out = n
    if node_is_validator(out) == false { return }
    if len(out.pending) == 0 { return }
    tip := chain_tip(out.chain)
    sorted := sort(out.chain.validators)
    nv := len(sorted)
    h := tip.height + 1
    expidx := h % nv
    myidx := index_of(sorted, out.pub)
    k := (myidx - expidx + nv) % nv
    oldest := now()
    i := 0
    while i < len(out.pending) {
        s := out.pend_since[out.pending[i].id]
        if s < oldest { oldest = s }
        i = i + 1
    }
    age := now() - oldest
    need := 1 + k * out.cfg.block_interval
    if age < need { return }
    if now() - tip.ts < 1 { return }
    batch := []Entry{}
    j := 0
    while j < len(out.pending) && len(batch) < 200 { batch = append(batch, out.pending[j])  j = j + 1 }
    raw := json(block_seal(out.seedhex, tip, batch))
    o, err := node_append(out, raw, "seal")
    if len(err) > 0 {
        logmsg("seal rejected: " + err + "; dropping stale pending entries")
        out = drop_invalid_pending(out)
        return
    }
    out = o
    out.sealed = out.sealed + 1
    node_broadcast(out, block_line(out, raw))
}

func drop_invalid_pending(n) (out) {
    out = n
    keep := []Entry{}
    i := 0
    while i < len(out.pending) {
        e := out.pending[i]
        if entry_valid(e) && entry_allowed(out.chain, e) && has(out.chain.included, e.id) == false {
            keep = append(keep, e)
        } else {
            delete(out.pend_ids, e.id)
            delete(out.pend_since, e.id)
        }
        i = i + 1
    }
    out.pending = keep
    store_save_pending(out.datadir, out.pending)
}

func on_tick(n) (out) {
    out = n
    t := now()
    if t - out.last_sync >= out.cfg.sync_interval {
        out.last_sync = t
        line := hello_line(out)
        i := 0
        while i < len(out.peers) {
            p := out.peers[i]
            // back off dead peers: every 6th round after 5 failures
            if p.fails < 5 || (t / out.cfg.sync_interval) % 6 == 0 { out = node_send(out, p.addr, line) }
            i = i + 1
        }
        // re-announce pending entries older than two sync rounds (a relay may have been down)
        sent := 0
        j := 0
        while j < len(out.pending) && sent < 50 {
            e := out.pending[j]
            if t - out.pend_since[e.id] >= 2 * out.cfg.sync_interval {
                node_broadcast(out, entry_line(out, e))
                sent = sent + 1
            }
            j = j + 1
        }
    }
    if t - g_ctr["last_ping"] >= 30 && len(g_subfds) > 0 {
        g_ctr["last_ping"] = t
        sub_push_all(msg_ok(""))
    }
    out = sub_maintain(out)
    out = try_seal(out)
}

// ---- event loop ----

func ev_parse(ev) (kind, a, rest) {
    kind = ev
    a = ""
    rest = ""
    t1 := index(ev, "\t")
    if t1 < 0 { return }
    kind = substr(ev, 0, t1)
    r := substr(ev, t1 + 1, len(ev))
    t2 := index(r, "\t")
    if t2 < 0 { a = r  return }
    a = substr(r, 0, t2)
    rest = substr(r, t2 + 1, len(r))
}

func on_in(n, fd, raw) (out) {
    out = n
    if len(raw) == 0 { close(fd)  return }
    if has_prefix(raw, "{\"t\":\"sub\"") {
        // a NAT'd peer subscribing: keep the socket, push announcements to it until it dies
        cap := 16
        if out.cfg.relay { cap = 256 }
        if len(g_subfds) >= cap { write(fd, msg_ok("too many subscribers") + "\n")  close(fd)  return }
        m := parse(raw, Msg{})
        if m.genesis != out.chain.heads[0].hash { write(fd, msg_ok("genesis mismatch") + "\n")  close(fd)  return }
        socket_timeout(fd, 10000)
        write(fd, hello_line(out) + "\n")
        g_subfds[fd] = 1
        return
    }
    if has_prefix(raw, "{") {
        o, resp := handle_p2p(out, raw, peer_addr(fd))
        out = o
        write(fd, resp + "\n")
        close(fd)
        return
    }
    o2, res := handle_http(out, parse_request(raw))
    out = o2
    write(fd, res)
    close(fd)
}

func rss_kb() (kb) {
    // /proc files read as empty via read_file (size 0), so ask ps about our own pid ($PPID of the shell).
    code, out, err := exec("ps -o rss= -p $PPID")
    kb = parse_int(trim(out))
}

// node_gc keeps a long-running single-actor loop flat: the main goroutine's arena never
// returns, so every parsed message would otherwise live forever. When RSS has grown past a
// threshold (or after a quiet minute) we free the whole arena and rebuild the node from
// disk (chain.jsonl / pending.jsonl / peers.json are the truth). Cross-reset state = ints
// in g_ctr / g_sub*, the channel, fds.
func node_gc(n) (out) {
    out = n
    g_ctr["events"] = g_ctr["events"] + 1
    if g_ctr["events"] % 25 != 0 { return }
    rss := rss_kb()
    if len(env("GREFFE_DEBUG")) > 0 && g_ctr["events"] % 100 == 0 {
        logmsg("mem events=" + str(g_ctr["events"]) + " rss=" + str(rss) + "kB in=" + str(g_ctr["ev_in"]) + " re=" + str(g_ctr["ev_re"]) + " push=" + str(g_ctr["ev_push"]) + " pending=" + str(len(out.pending)) + " height=" + str(chain_tip(out.chain).height))
    }
    grown := rss - g_ctr["rss_base"]
    idle := now() - g_ctr["last_gc"] >= 60
    if grown < 24576 && (idle == false || grown < 4096) && g_ctr["events"] < 5000 { return }
    if out_inflight_count(out) > 0 && grown < 131072 { return }
    g_ctr["sealed"] = out.sealed
    g_ctr["reorgs"] = out.reorgs
    g_ctr["started"] = out.started
    g_ctr["last_sync"] = out.last_sync
    g_ctr["gcs"] = g_ctr["gcs"] + 1
    g_ctr["events"] = 0
    g_ctr["last_gc"] = now()
    arena_reset()
    fresh, err := node_load(data_dir_from_argv())
    if len(err) > 0 { logmsg("gc reload failed: " + err)  exit(3) }
    out = fresh
    out.sealed = g_ctr["sealed"]
    out.reorgs = g_ctr["reorgs"]
    out.started = g_ctr["started"]
    out.last_sync = g_ctr["last_sync"]
    g_ctr["rss_base"] = rss_kb()
    if len(env("GREFFE_DEBUG")) > 0 { logmsg("gc #" + str(g_ctr["gcs"]) + " rss " + str(rss) + "kB -> " + str(g_ctr["rss_base"]) + "kB") }
}

func out_inflight_count(n) (c) {
    c = 0
    ks := keys(n.inflight)
    i := 0
    while i < len(ks) { if n.inflight[ks[i]] { c = c + 1 }  i = i + 1 }
}

func node_serve(n) {
    ch := g_evch
    srv := listen(n.cfg.port)
    if srv < 0 { out_fail("cannot bind port " + str(n.cfg.port), 1) }
    go gr_acceptor(srv, ch)
    go gr_ticker(ch)
    role := "full node"
    if node_is_validator(n) { role = "validator" }
    if n.cfg.relay { role = "relay" }
    if n.cfg.nat { role = role + " (behind NAT)" }
    logmsg("greffe " + greffe_version() + " '" + n.cfg.name + "' " + role + " " + substr(n.pub, 0, 12) + " listening on :" + str(n.cfg.port) + " height " + str(chain_tip(n.chain).height))
    n.last_sync = now() - n.cfg.sync_interval
    g_ctr["last_gc"] = now()
    g_ctr["rss_base"] = rss_kb()
    for {
        ev := <-ch
        kind, a, rest := ev_parse(ev)
        if kind == "tick" { n = on_tick(n)  g_ctr["ev_tick"] = g_ctr["ev_tick"] + 1 }
        if kind == "in" { n = on_in(n, parse_int(a), rest)  g_ctr["ev_in"] = g_ctr["ev_in"] + 1 }
        if kind == "re" { n = on_reply(n, a, rest)  g_ctr["ev_re"] = g_ctr["ev_re"] + 1 }
        if kind == "push" { n = on_push(n, a, rest)  g_ctr["ev_push"] = g_ctr["ev_push"] + 1 }
        if kind == "subend" { g_sub[addr_hash(a)] = 0  logmsg("subscription to " + a + " dropped") }
        n = node_gc(n)
    }
}
